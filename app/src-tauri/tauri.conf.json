{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podcast Transcribe",
  "version": "0.1.0",
  "identifier": "com.sightline.transcribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Podcast Transcribe",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' asset: data:; media-src 'self' asset: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/*", "$APPLOCALDATA/*", "$AUDIO/*", "$DOCUMENT/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "resources": []
  }
}
