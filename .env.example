# Hugging Face token (read scope) — required for speaker diarization.
# Create one at https://hf.co/settings/tokens
# Then accept the model terms (see README "Speaker diarization setup").
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs API key — only needed for compare_elevenlabs.py (the commercial comparison).
# Create one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
